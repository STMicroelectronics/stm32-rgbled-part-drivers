{{assign 'rgbled_instances' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::Board Part:STM32CubeMX2 Config:RGBLED")~}}

/* Define to prevent recursive inclusion ----------------------------------- */
#ifndef MX_RGBLED_BURST_CONTROL_H
#define MX_RGBLED_BURST_CONTROL_H

#ifdef __cplusplus
extern "C" {
#endif

/* Includes ---------------------------------------------------------------- */
#include "rgbled.h"
#include "mx_hal_def.h"

/* Exported macros --------------------------------------------------------- */
{{#each @root.rgbled_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'instance_index' @index~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'PWM BURST CONTROL')~}}
/* Part Config ID */
#define MX_RGBLED_{{@root.instance_index}}                                  {{@root.instance_index}}U

{{#if (length info.labels)}}
/* User-defined aliases for the RGBLED instance IDs and getter functions */
{{else}}
/* No user alias is defined for MX_RGBLED_{{@root.instance_index}}. */
{{/if}}
{{#each info.labels}}
#define {{this}}                              MX_RGBLED_{{@root.instance_index}}
{{/each}}
{{#each info.labels}}
#define {{lowercase this}}_getobject()       mx_rgbled_{{@root.instance_index}}_getobject()
{{/each}}

/* Resource bindings */
{{#with resourcesAllocation.pwmBurstCfg}}
#define MX_RGBLED_{{@root.instance_index}}_RED_TIM_GETHANDLE()          mx_{{lowercase red.timInstance.selection}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_RED_TIM_CHANNEL              {{red.timChannel}}
#define MX_RGBLED_{{@root.instance_index}}_GREEN_TIM_GETHANDLE()        mx_{{lowercase green.timInstance.selection}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_GREEN_TIM_CHANNEL            {{green.timChannel}}
#define MX_RGBLED_{{@root.instance_index}}_BLUE_TIM_GETHANDLE()         mx_{{lowercase blue.timInstance.selection}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_BLUE_TIM_CHANNEL             {{blue.timChannel}}
#define MX_RGBLED_{{@root.instance_index}}_PATTERN_TIM_GETHANDLE()      mx_{{lowercase patternTimer.timInstance.selection}}_gethandle()

/* Current regulation in burst pulses (DAC + COMP) resource bindings */
{{assign 'RedCompInstance' advancedCfg.red.compInstance.selection~}}
{{assign 'RedCompInstanceLowercase' (lowercase @root.RedCompInstance)~}}
{{assign 'GreenCompInstance' advancedCfg.green.compInstance.selection~}}
{{assign 'GreenCompInstanceLowercase' (lowercase @root.GreenCompInstance)~}}
{{assign 'BlueCompInstance' advancedCfg.blue.compInstance.selection~}}
{{assign 'BlueCompInstanceLowercase' (lowercase @root.BlueCompInstance)~}}
#define MX_RGBLED_{{@root.instance_index}}_RED_COMP_GETHANDLE()         mx_{{helper_rgbled_get_comp_instance_name @root.RedCompInstanceLowercase}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_RED_DAC_GETHANDLE()          mx_{{lowercase advancedCfg.red.dacInstance.selection}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_RED_DAC_CHANNEL              {{advancedCfg.red.dacChannel}}
#define MX_RGBLED_{{@root.instance_index}}_GREEN_COMP_GETHANDLE()       mx_{{helper_rgbled_get_comp_instance_name @root.GreenCompInstanceLowercase}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_GREEN_DAC_GETHANDLE()        mx_{{lowercase advancedCfg.green.dacInstance.selection}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_GREEN_DAC_CHANNEL            {{advancedCfg.green.dacChannel}}
#define MX_RGBLED_{{@root.instance_index}}_BLUE_COMP_GETHANDLE()        mx_{{helper_rgbled_get_comp_instance_name @root.BlueCompInstanceLowercase}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_BLUE_DAC_GETHANDLE()         mx_{{lowercase advancedCfg.blue.dacInstance.selection}}_gethandle()
#define MX_RGBLED_{{@root.instance_index}}_BLUE_DAC_CHANNEL             {{advancedCfg.blue.dacChannel}}

{{/with~}}

{{/if~}}
{{/with~}}
{{/each~}}

/* Exported functions ------------------------------------------------------ */
{{#each @root.rgbled_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'instance_index' @index~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'PWM BURST CONTROL')~}}
rgbled_obj_t *mx_rgbled_{{@root.instance_index}}_getobject(void);
{{/if~}}
{{/with~}}
{{/each~}}

#ifdef __cplusplus
}
#endif

#endif /* MX_RGBLED_BURST_CONTROL_H */
