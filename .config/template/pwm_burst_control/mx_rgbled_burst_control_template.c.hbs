{{assign 'rgbled_instances' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::Board Part:STM32CubeMX2 Config:RGBLED")~}}

/* Includes ---------------------------------------------------------------- */
#include "mx_rgbled_burst_control.h"

/* Private objects --------------------------------------------------------- */
{{#each @root.rgbled_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'instance_index' @index~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'PWM BURST CONTROL')~}}
static rgbled_obj_t rgbled_{{@root.instance_index}}_obj;
{{/if~}}
{{/with~}}
{{/each~}}

/**
  * @brief Bind generated TIM resources to the RGBLED object.
  * @param pobj pointer to the RGBLED object.
  * @retval 0 on success, -1 otherwise.
  */
int32_t rgbled_io_init(rgbled_obj_t *pobj)
{
  if (pobj == NULL)
  {
    return -1;
  }

  switch (pobj->id)
  {
{{#each @root.rgbled_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'instance_index' @index~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'PWM BURST CONTROL')~}}
    case MX_RGBLED_{{@root.instance_index}}:
      pobj->red.phtim = MX_RGBLED_{{@root.instance_index}}_RED_TIM_GETHANDLE();
      pobj->red.pwm_channel = MX_RGBLED_{{@root.instance_index}}_RED_TIM_CHANNEL;
      pobj->green.phtim = MX_RGBLED_{{@root.instance_index}}_GREEN_TIM_GETHANDLE();
      pobj->green.pwm_channel = MX_RGBLED_{{@root.instance_index}}_GREEN_TIM_CHANNEL;
      pobj->blue.phtim = MX_RGBLED_{{@root.instance_index}}_BLUE_TIM_GETHANDLE();
      pobj->blue.pwm_channel = MX_RGBLED_{{@root.instance_index}}_BLUE_TIM_CHANNEL;
      pobj->pattern_timer.phtim = MX_RGBLED_{{@root.instance_index}}_PATTERN_TIM_GETHANDLE();
      pobj->red.phcomp = MX_RGBLED_{{@root.instance_index}}_RED_COMP_GETHANDLE();
      pobj->red.phdac = MX_RGBLED_{{@root.instance_index}}_RED_DAC_GETHANDLE();
      pobj->red.dac_channel = MX_RGBLED_{{@root.instance_index}}_RED_DAC_CHANNEL;
      pobj->green.phcomp = MX_RGBLED_{{@root.instance_index}}_GREEN_COMP_GETHANDLE();
      pobj->green.phdac = MX_RGBLED_{{@root.instance_index}}_GREEN_DAC_GETHANDLE();
      pobj->green.dac_channel = MX_RGBLED_{{@root.instance_index}}_GREEN_DAC_CHANNEL;
      pobj->blue.phcomp = MX_RGBLED_{{@root.instance_index}}_BLUE_COMP_GETHANDLE();
      pobj->blue.phdac = MX_RGBLED_{{@root.instance_index}}_BLUE_DAC_GETHANDLE();
      pobj->blue.dac_channel = MX_RGBLED_{{@root.instance_index}}_BLUE_DAC_CHANNEL;
      break;
{{/if~}}
{{/with~}}
{{/each~}}
    default:
      return -1;
  }

  return 0;
}

{{#each @root.rgbled_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'instance_index' @index~}}
{{#with @root.ctx}}
{{#if (eq info.interface 'PWM BURST CONTROL')~}}
/**
  * @brief Return the generated RGBLED object for instance {{@root.instance_index}}.
  * @retval RGBLED object pointer.
  */
rgbled_obj_t *mx_rgbled_{{@root.instance_index}}_getobject(void)
{
  return &rgbled_{{@root.instance_index}}_obj;
}
{{/if~}}
{{/with~}}
{{/each~}}
