{{assign 'rgbled_instances' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::Board Part:STM32CubeMX2 Config:RGBLED")~}}
{{assign 'IsPwmNoControlUsed' false~}}
{{assign 'IsPwmBurstUsed' false~}}
{{assign 'IsPwmThresholdUsed' false~}}
{{#each @root.rgbled_instances~}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#if (eq @root.ctx.info.interface 'PWM NO CONTROL')~}}
{{assign 'IsPwmNoControlUsed' true~}}
{{/if}}
{{#if (eq @root.ctx.info.interface 'PWM BURST CONTROL')~}}
{{assign 'IsPwmBurstUsed' true~}}
{{/if}}
{{#if (eq @root.ctx.info.interface 'PWM THRESHOLD CONTROL')~}}
{{assign 'IsPwmThresholdUsed' true~}}
{{/if}}
{{/each}}
{{!-- GPDSC Data Model has all the MX2 stores getters APIs already exposed --}}
{{!-- Getters APIs README:
https://github.com/PRG-Cube/cube-code-generation/blob/main/npm/code-generation-service/doc/README_getters.md --}}
{{!-- [1] You can inspect the content of the GPDSC data model by uncommenting the following line--}}
{{!-- {{{log "GPDSCDataModel" @root}}} --}}
{{!-- [2] Getters APIs usage example: You can access the SW Configuration Store using SW Config dedicated getters
following this synthaxe--}}
{{!-- {{assign 'Comp_SW_Instances' (@root.SWConfigurationAPI.getInstances "STMicroelectronics::Device:STM32 HAL Code
Gen:I2C Init")~}}
{{!-- {{log "SW_Instances" @root.Comp_SW_Instances~}} --}}
{{!-- [3] All CodeGen common helpers described in this link
(https://github.com/PRG-Cube/cube-code-generation/blob/main/npm/code-generation-service/doc/README_helpers.md) are
already available for usage in this template --}}
<?xml version="1.0" encoding="UTF-8"?>
<!-- ******************************************************************************
 * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
 * Description : Generator PDSC File generated by CodeGen
 ****************************************************************************** -->
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updated--}}
  <releases>
    <release version="0.0.1" date="2024-07-17">
      - First GPDSC template Model Release
    </release>
  </releases>
  <conditions>
    {{!-- this is a dedicated Helper to extract All PDSC conditions and inject them into the <conditions></conditions>
    section--}}
    {{!-- This Helper supports condition exclusions using the following synthaxe--}}
    {{!-- {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="CMSIS OS, TEMPLATE OS, Timebase
    Init")}} --}}
    {{!-- the following 2 lines are mandatory to keep for PDSC conditions inclusion at GPDSC generation in runtime--}}
    {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters  exclude="RGBLED CFG Condition")}}
    {{{@root.conditions}}}
    {{!-- Excluded conditions by Id above could optionally be handled dynamically in this section--}}
    {{!-- #Start Dynamic condition handling section# --}}
    <condition id="RGBLED CFG Condition">
      <description>STMicroelectronics configuration for RGBLED part driver</description>
{{#if (eq IsPwmNoControlUsed true)}}
  <require Cclass="Board Part" Cgroup="RGBLED" Csub="PWM NO CONTROL"/>
{{/if}}
{{#if (eq IsPwmBurstUsed true)}}
  <require Cclass="Board Part" Cgroup="RGBLED" Csub="PWM BURST CONTROL"/>
{{/if}}
{{#if (eq IsPwmThresholdUsed true)}}
  <require Cclass="Board Part" Cgroup="RGBLED" Csub="PWM THRESHOLD CONTROL"/>
{{/if}}
    </condition>
    {{!-- #End Dynamic condition handling section# --}}

  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  {{!-- This is supported by codegen version >= v6.13.0 --}}
  <components>
    {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>
